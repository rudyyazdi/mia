{
  "profile": "fixture-test",
  "stateDirectory": "../../.mia-state/fixture-test",
  "server": {
    "host": "127.0.0.1",
    "port": 48731,
    "secretFile": "../../.mia-state/fixture-test/client-secret"
  },
  "runtime": {
    "kind": "claude-code",
    "executable": "claude",
    "model": "claude-sonnet-5",
    "effort": "medium",
    "workingDirectory": "../../.mia-work/fixture-test",
    "mcpServers": {
      "fixture": {
        "type": "http",
        "url": "${MIA_FIXTURE_MCP_URL}",
        "bodyLog": "${MIA_FIXTURE_DIR}/mcp-bodies.jsonl"
      }
    },
    "toolPolicy": {
      "mcp__fixture__read": "allow",
      "mcp__fixture__change": "ask",
      "mcp__fixture__slow": "ask",
      "mcp__fixture__artifact": "ask",
      "mcp__fixture__forbidden": "deny"
    },
    "agentPromptFile": "../../prompts/manager-v1.md",
    "workerAgent": {
      "description": "Runs one task that needs tools, calling exactly the tools the task names. Use it for every tool call.",
      "promptFile": "../../prompts/worker-v1.md"
    },
    "exclusiveTools": ["mcp__fixture__slow"],
    "outputDirectories": ["${MIA_FIXTURE_DIR}/artifacts"],
    "env": {},
    "extraSettings": {}
  },
  "architectureDocument": "../../docs/PLAN.md",
  "notes": [
    "Test profile: Sonnet was chosen by the maintainer for harness testing. Every tool is routed through the approval bridge; only deny becomes a runtime rule."
  ]
}
