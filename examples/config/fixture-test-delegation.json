{
  "profile": "fixture-test-delegation",
  "stateDirectory": "../../.mia-state/fixture-test-delegation",
  "server": {
    "host": "127.0.0.1",
    "port": 48733,
    "secretFile": "../../.mia-state/fixture-test-delegation/client-secret"
  },
  "runtime": {
    "kind": "claude-code",
    "executable": "claude",
    "model": "claude-sonnet-5",
    "effort": "medium",
    "workingDirectory": "../../.mia-work/fixture-test-delegation",
    "builtinTools": [],
    "mcpServers": {
      "d1": {
        "type": "http",
        "url": "${MIA_FIXTURE_MCP_URL}",
        "bodyLog": "${MIA_FIXTURE_DIR}/mcp-bodies.jsonl"
      }
    },
    "toolPolicy": {
      "mcp__d1__read": "allow",
      "mcp__d1__change": "ask",
      "mcp__d1__slow": "ask",
      "mcp__d1__artifact": "ask",
      "mcp__d1__forbidden": "deny"
    },
    "agentPromptFile": "../../prompts/manager-v1.md",
    "outputDirectories": ["${MIA_FIXTURE_DIR}/artifacts"],
    "env": {},
    "extraSettings": {},
    "workerAgent": {
      "description": "Runs one task that needs tools, calling exactly the tools the task names. Use it for every tool call.",
      "promptFile": "../../prompts/worker-v1.md"
    },
    "exclusiveTools": ["mcp__d1__slow"]
  },
  "architectureDocument": "../../docs/PLAN.md",
  "notes": [
    "D2 test profile: a manager agent that delegates every tool call to worker agents (docs/PLAN.md, Deliverable 2). mcp__d1__slow stands in for an exclusive tool."
  ]
}
